{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game.definition.v1",
  "title": "Main Computer Game Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "version",
    "start",
    "rooms"
  ],
  "properties": {
    "schema": {
      "const": "game.definition.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string"
    },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "room",
        "spawn"
      ],
      "properties": {
        "room": {
          "type": "string",
          "minLength": 1
        },
        "spawn": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/room"
      }
    },
    "exits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exit"
      },
      "default": []
    },
    "spawns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/spawn"
      },
      "default": []
    },
    "props": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prop"
      },
      "default": []
    },
    "terminals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/terminal"
      },
      "default": []
    },
    "interactables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interactable"
      },
      "default": []
    },
    "interactions": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interaction"
          }
        },
        {
          "$ref": "#/$defs/interactionMap"
        }
      ],
      "default": []
    },
    "objectives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/objective"
      },
      "default": []
    },
    "encounters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/encounter"
      },
      "default": []
    },
    "stateDefaults": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requireConnectedRooms": {
          "type": "boolean",
          "default": true
        },
        "requireReachableTerminals": {
          "type": "boolean",
          "default": true
        },
        "requireReachableInteractables": {
          "type": "boolean",
          "default": true
        },
        "requireInteractionHandlers": {
          "type": "boolean",
          "default": true
        },
        "requireObjectiveTargets": {
          "type": "boolean",
          "default": true
        },
        "requireSpawnInsideRoom": {
          "type": "boolean",
          "default": true
        },
        "requireRoomBoundsInsideMovement": {
          "type": "boolean",
          "default": true
        },
        "requireOpenDoors": {
          "type": "boolean",
          "default": true
        },
        "requireRenderableProps": {
          "type": "boolean",
          "default": true
        },
        "requirePropTargets": {
          "type": "boolean",
          "default": true
        },
        "requireInteractionEffects": {
          "type": "boolean",
          "default": true
        },
        "requireDefinitionVersion": {
          "type": "boolean",
          "default": true
        }
      },
      "default": {}
    },
    "movement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bounds": {
          "$ref": "#/$defs/bounds"
        },
        "colliders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/collider"
          },
          "default": []
        }
      },
      "default": {}
    },
    "definitionVersion": {
      "type": "string",
      "description": "Runtime definition/migration target version, for example game.motherShipInterior.definition.v2."
    },
    "stateVersion": {
      "type": "string",
      "description": "Runtime state/default compatibility version, for example game.motherShipInterior.state.v1."
    },
    "migration": {
      "$ref": "#/$defs/migrationReport"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "number": {
      "type": "number"
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minX",
        "maxX",
        "minZ",
        "maxZ"
      ],
      "properties": {
        "minX": {
          "type": "number"
        },
        "maxX": {
          "type": "number"
        },
        "minZ": {
          "type": "number"
        },
        "maxZ": {
          "type": "number"
        }
      }
    },
    "position": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "bounds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        },
        "bounds": {
          "$ref": "#/$defs/bounds"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "render": {
          "type": "object",
          "additionalProperties": true,
          "default": {}
        },
        "location": {
          "$ref": "#/$defs/id"
        },
        "priority": {
          "type": "number"
        },
        "visual": {
          "$ref": "#/$defs/roomVisual"
        },
        "geometry": {
          "$ref": "#/$defs/roomGeometry"
        }
      }
    },
    "exit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "bounds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "bounds": {
          "$ref": "#/$defs/bounds"
        },
        "render": {
          "type": "object",
          "additionalProperties": true,
          "default": {}
        },
        "door": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "spawn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "room",
        "position",
        "yaw"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "room": {
          "$ref": "#/$defs/id"
        },
        "position": {
          "oneOf": [
            {
              "$ref": "#/$defs/position"
            },
            {
              "$ref": "#/$defs/position3"
            }
          ]
        },
        "yaw": {
          "type": "number"
        },
        "label": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/id"
        },
        "pitch": {
          "type": "number"
        }
      }
    },
    "prop": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "room",
        "kind",
        "position"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "room": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "description": "Procedural content prop kind. Current renderer supports floor-marker, map-marker, sign, beacon, light-strip, status-panel, terminal-console, and viewscreen.",
          "examples": [
            "floor-marker",
            "map-marker",
            "sign",
            "beacon",
            "light-strip",
            "status-panel",
            "terminal-console",
            "viewscreen"
          ]
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "label": {
          "type": "string"
        },
        "size": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "maxItems": 3
        },
        "display": {
          "type": "string",
          "description": "Optional content display program rendered by a prop. Patch P currently supports enemyShipTactical for viewscreen props.",
          "examples": [
            "enemyShipTactical"
          ]
        },
        "color": {
          "type": "string"
        },
        "emissive": {
          "type": "boolean"
        },
        "target": {
          "type": "string"
        },
        "facing": {
          "type": "string"
        },
        "axis": {
          "type": "string"
        }
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "room",
        "position",
        "radius",
        "label",
        "prompt",
        "interaction"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "room": {
          "$ref": "#/$defs/id"
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "interaction": {
          "$ref": "#/$defs/id"
        },
        "statusKey": {
          "type": "string"
        }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "handler"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "handler": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "emitsState": {
          "type": "boolean"
        },
        "changesState": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "successStatus": {
          "type": "string"
        },
        "nextObjective": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          ]
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string"
        },
        "completeWhen": {
          "type": "string"
        }
      }
    },
    "encounter": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "stateKey": {
          "type": "string"
        },
        "defaults": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "position3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "collider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "minX",
        "maxX",
        "minZ",
        "maxZ"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "minX": {
          "type": "number"
        },
        "maxX": {
          "type": "number"
        },
        "minZ": {
          "type": "number"
        },
        "maxZ": {
          "type": "number"
        }
      }
    },
    "interactable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "room",
        "position",
        "radius",
        "label",
        "prompt",
        "action"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "access",
            "door",
            "terminal",
            "prop"
          ]
        },
        "room": {
          "$ref": "#/$defs/id"
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "$ref": "#/$defs/id"
        },
        "target": {
          "type": "string"
        },
        "statusKey": {
          "type": "string"
        },
        "visual": {
          "$ref": "#/$defs/interactableVisual"
        }
      }
    },
    "interactionMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/interaction"
      },
      "default": {}
    },
    "interactableVisual": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": {
          "type": "string",
          "minLength": 1
        },
        "activeColor": {
          "type": "string",
          "minLength": 1
        },
        "radiusScale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "activeHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "baseSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "terminalPanel": {
          "type": "boolean"
        },
        "routeBeam": {
          "type": "boolean"
        }
      },
      "default": {}
    },
    "roomVisual": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": {
          "type": "string",
          "minLength": 1
        },
        "edgeColor": {
          "type": "string",
          "minLength": 1
        },
        "labelColor": {
          "type": "string",
          "minLength": 1
        },
        "boundary": {
          "type": "boolean"
        },
        "floorBand": {
          "type": "boolean"
        },
        "label": {
          "type": "boolean"
        },
        "labelHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "default": {}
    },
    "roomGeometry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "string"
        },
        "room": {
          "$ref": "#/$defs/id"
        },
        "enabled": {
          "type": "boolean"
        },
        "accentColor": {
          "type": "string"
        },
        "shell": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "bounds": {
                  "$ref": "#/$defs/bounds"
                },
                "accentColor": {
                  "type": "string"
                },
                "floor": {
                  "type": "boolean"
                },
                "ceiling": {
                  "type": "boolean"
                },
                "floorMinY": {
                  "type": "number"
                },
                "floorMaxY": {
                  "type": "number"
                },
                "ceilingMinY": {
                  "type": "number"
                },
                "ceilingMaxY": {
                  "type": "number"
                },
                "accentBeams": {
                  "type": "boolean"
                }
              }
            }
          ]
        },
        "walls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "axis": {
                "enum": [
                  "x",
                  "z"
                ]
              },
              "x": {
                "type": "number"
              },
              "z": {
                "type": "number"
              },
              "minX": {
                "type": "number"
              },
              "maxX": {
                "type": "number"
              },
              "minZ": {
                "type": "number"
              },
              "maxZ": {
                "type": "number"
              },
              "color": {
                "type": "string"
              },
              "emissive": {
                "type": "boolean"
              }
            },
            "required": [
              "axis"
            ]
          },
          "default": []
        },
        "openings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "exit": {
                "$ref": "#/$defs/id"
              },
              "door": {
                "$ref": "#/$defs/id"
              },
              "edge": {
                "type": "string"
              },
              "bounds": {
                "$ref": "#/$defs/bounds"
              }
            }
          },
          "default": []
        },
        "doorPanels": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "door": {
                "$ref": "#/$defs/id"
              },
              "center": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              },
              "centerX": {
                "type": "number"
              },
              "centerZ": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "vertical": {
                "type": "boolean"
              }
            }
          },
          "default": []
        },
        "boxes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "min": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "max": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "color": {
                "type": "string"
              },
              "emissive": {
                "type": "boolean"
              }
            }
          },
          "default": []
        },
        "beams": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "start": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "end": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "radius": {
                "type": "number"
              },
              "color": {
                "type": "string"
              },
              "emissive": {
                "type": "boolean"
              },
              "pulse": {
                "type": "boolean"
              }
            }
          },
          "default": []
        },
        "lighting": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/roomGeometry/properties/beams/items"
          },
          "default": []
        }
      },
      "default": {}
    },
    "migrationReport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "game.motherShipInterior.migration.v1"
        },
        "sourceDefinitionVersion": {
          "type": "string"
        },
        "targetDefinitionVersion": {
          "type": "string"
        },
        "stateVersion": {
          "type": "string"
        },
        "migratedAtLoad": {
          "type": "boolean"
        },
        "migrations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "defaultsApplied": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "default": {}
    }
  }
}
