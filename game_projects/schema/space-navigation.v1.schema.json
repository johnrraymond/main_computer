{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game.spaceNavigation.v1",
  "title": "Main Computer Space Navigation Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enabled",
    "schema",
    "definitionVersion",
    "stateVersion",
    "startSystem",
    "captainScrawl",
    "policy",
    "arrivalProfiles",
    "systems",
    "routes",
    "stateDefaults",
    "validation"
  ],
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "schema": {
      "const": "game.spaceNavigation.v1"
    },
    "definitionVersion": {
      "const": "game.spaceNavigation.definition.v2"
    },
    "stateVersion": {
      "const": "game.spaceNavigation.state.v2"
    },
    "startSystem": {
      "$ref": "#/$defs/id"
    },
    "captainScrawl": {
      "type": "string",
      "minLength": 1
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "arrivalProfiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/arrivalProfile"
      }
    },
    "systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/system"
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "stateDefaults": {
      "$ref": "#/$defs/stateDefaults"
    },
    "validation": {
      "$ref": "#/$defs/validation"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "position": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jumpMode",
        "directJumpRequiresRoute",
        "mapPositionAuthoritative",
        "allowDirectedRoutes"
      ],
      "properties": {
        "jumpMode": {
          "const": "adjacent-only"
        },
        "directJumpRequiresRoute": {
          "const": true
        },
        "mapPositionAuthoritative": {
          "const": false
        },
        "allowDirectedRoutes": {
          "type": "boolean"
        }
      }
    },
    "arrivalProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "sceneId",
        "location"
      ],
      "properties": {
        "mode": {
          "enum": [
            "retain-player",
            "spawn-player"
          ]
        },
        "sceneId": {
          "$ref": "#/$defs/id"
        },
        "location": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "region",
        "mapPosition",
        "localSpaceId",
        "arrivalProfile",
        "primaryPlanet"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "$ref": "#/$defs/id"
        },
        "mapPosition": {
          "$ref": "#/$defs/position"
        },
        "localSpaceId": {
          "$ref": "#/$defs/id"
        },
        "arrivalProfile": {
          "$ref": "#/$defs/id"
        },
        "stars": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/star"
          }
        },
        "primaryPlanet": {
          "$ref": "#/$defs/planet"
        },
        "additionalPlanets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/planet"
          }
        },
        "arrivalDestinationId": {
          "$ref": "#/$defs/id"
        },
        "localDestinations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/localDestination"
          }
        },
        "localRoutes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/localRoute"
          }
        }
      },
      "dependentRequired": {
        "arrivalDestinationId": [
          "localDestinations",
          "localRoutes"
        ],
        "localDestinations": [
          "arrivalDestinationId",
          "localRoutes"
        ],
        "localRoutes": [
          "arrivalDestinationId",
          "localDestinations"
        ]
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "bidirectional",
        "presentationDurationMs",
        "worldTimeCost"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "bidirectional": {
          "type": "boolean"
        },
        "presentationDurationMs": {
          "type": "integer",
          "minimum": 0
        },
        "worldTimeCost": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "stateDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currentSystemId",
        "plottedRouteId",
        "travelPhase",
        "elapsedWorldTime",
        "discoveredSystems",
        "currentLocalDestinationId",
        "discoveredLocalDestinations"
      ],
      "properties": {
        "currentSystemId": {
          "$ref": "#/$defs/id"
        },
        "plottedRouteId": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "travelPhase": {
          "enum": [
            "in-system",
            "course-plotted",
            "warp-charging",
            "in-warp",
            "arriving"
          ]
        },
        "elapsedWorldTime": {
          "type": "integer",
          "minimum": 0
        },
        "discoveredSystems": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "currentLocalDestinationId": {
          "$ref": "#/$defs/id"
        },
        "discoveredLocalDestinations": {
          "$ref": "#/$defs/discoveredLocalDestinations"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requireUniqueSystemIds",
        "requireUniqueRouteIds",
        "requireRouteReferences",
        "requireDistinctRouteEndpoints",
        "requireAtLeastOneRoutePerSystem",
        "requireStartReachability",
        "requireArrivalProfiles",
        "requireStateReferences",
        "requireUniqueMapPositions",
        "requirePrimaryPlanetPerSystem",
        "requireUniquePlanetIds",
        "requireUniqueLocalDestinationIds",
        "requireUniqueLocalRouteIds",
        "requireLocalDestinationReferences",
        "requireLocalRouteReferences",
        "requireLocalArrivalDestination",
        "requireLocalReachability",
        "requireLocalStateReferences"
      ],
      "properties": {
        "requireUniqueSystemIds": {
          "const": true
        },
        "requireUniqueRouteIds": {
          "const": true
        },
        "requireRouteReferences": {
          "const": true
        },
        "requireDistinctRouteEndpoints": {
          "const": true
        },
        "requireAtLeastOneRoutePerSystem": {
          "const": true
        },
        "requireStartReachability": {
          "const": true
        },
        "requireArrivalProfiles": {
          "const": true
        },
        "requireStateReferences": {
          "const": true
        },
        "requireUniqueMapPositions": {
          "const": true
        },
        "requirePrimaryPlanetPerSystem": {
          "const": true
        },
        "requireUniquePlanetIds": {
          "const": true
        },
        "requireUniqueLocalDestinationIds": {
          "const": true
        },
        "requireUniqueLocalRouteIds": {
          "const": true
        },
        "requireLocalDestinationReferences": {
          "const": true
        },
        "requireLocalRouteReferences": {
          "const": true
        },
        "requireLocalArrivalDestination": {
          "const": true
        },
        "requireLocalReachability": {
          "const": true
        },
        "requireLocalStateReferences": {
          "const": true
        }
      }
    },
    "rings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "color",
        "innerRadius",
        "outerRadius",
        "tiltDegrees"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "innerRadius": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 3.0
        },
        "outerRadius": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 4.0
        },
        "tiltDegrees": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      }
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "star": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "spectralClass",
        "color",
        "radiusScale",
        "role",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "spectralClass": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "radiusScale": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10.0
        },
        "role": {
          "enum": [
            "primary",
            "companion"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "planet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "classification",
        "radiusScale",
        "surfaceColor",
        "secondaryColor",
        "atmosphereColor",
        "cloudColor",
        "moonCount",
        "rings",
        "rotationPeriodHours",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "minLength": 1
        },
        "radiusScale": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2.0
        },
        "surfaceColor": {
          "$ref": "#/$defs/color"
        },
        "secondaryColor": {
          "$ref": "#/$defs/color"
        },
        "atmosphereColor": {
          "$ref": "#/$defs/color"
        },
        "cloudColor": {
          "$ref": "#/$defs/color"
        },
        "moonCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "rings": {
          "$ref": "#/$defs/rings"
        },
        "rotationPeriodHours": {
          "type": "number",
          "minimum": 0
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "habitable": {
          "type": "boolean"
        },
        "inhabited": {
          "type": "boolean"
        },
        "formerSystemId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "localDestination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "kind",
        "parentBodyId",
        "position",
        "discoveredByDefault",
        "availableByDefault",
        "visualProgram",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "planet-orbit",
            "moon-orbit",
            "station",
            "fleet",
            "wreck",
            "beacon",
            "settlement",
            "hazard",
            "deep-space"
          ]
        },
        "parentBodyId": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "discoveredByDefault": {
          "type": "boolean"
        },
        "availableByDefault": {
          "type": "boolean"
        },
        "visualProgram": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "localRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "bidirectional",
        "presentationDurationMs",
        "worldTimeCost"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "bidirectional": {
          "type": "boolean"
        },
        "presentationDurationMs": {
          "type": "integer",
          "minimum": 250
        },
        "worldTimeCost": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "discoveredLocalDestinations": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "$ref": "#/$defs/id"
        }
      }
    }
  }
}
