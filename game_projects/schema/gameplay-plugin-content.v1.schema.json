{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game.gameplayPluginContent.v1",
  "title": "Main Computer gameplay plugin content v1",
  "oneOf": [
    {
      "$ref": "#/$defs/scenario"
    },
    {
      "$ref": "#/$defs/encounter"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)+$"
    },
    "localId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:-[a-z0-9]+)*$"
    },
    "idArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true,
      "default": []
    },
    "localIdArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/localId"
      },
      "uniqueItems": true,
      "default": []
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "id",
        "title",
        "entryStage",
        "stages"
      ],
      "properties": {
        "schema": {
          "const": "game.gameplayPluginContent.v1"
        },
        "kind": {
          "const": "scenario"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "entry": {
          "$ref": "#/$defs/scenarioEntry"
        },
        "entryStage": {
          "$ref": "#/$defs/localId"
        },
        "completionStages": {
          "$ref": "#/$defs/localIdArray"
        },
        "encounterIds": {
          "$ref": "#/$defs/idArray"
        },
        "receiptIds": {
          "$ref": "#/$defs/idArray"
        },
        "outcomeIds": {
          "$ref": "#/$defs/idArray"
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/stage"
          }
        }
      }
    },
    "scenarioEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "systemId": {
          "$ref": "#/$defs/id"
        },
        "destinationId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "kind": {
          "enum": [
            "briefing",
            "choice",
            "travel",
            "encounter",
            "investigation",
            "resolution",
            "failure"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "objective": {
          "type": "string",
          "maxLength": 1000
        },
        "encounterId": {
          "$ref": "#/$defs/id"
        },
        "nextStage": {
          "$ref": "#/$defs/localId"
        },
        "onComplete": {
          "$ref": "#/$defs/localId"
        },
        "onFail": {
          "$ref": "#/$defs/localId"
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/choice"
          },
          "default": []
        },
        "receiptIds": {
          "$ref": "#/$defs/idArray"
        },
        "outcomeIds": {
          "$ref": "#/$defs/idArray"
        }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "nextStage": {
          "$ref": "#/$defs/localId"
        },
        "outcomeId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "encounter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "id",
        "title",
        "template",
        "participants",
        "objectives",
        "winConditions",
        "outcomes"
      ],
      "properties": {
        "schema": {
          "const": "game.gameplayPluginContent.v1"
        },
        "kind": {
          "const": "encounter"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "template": {
          "$ref": "#/$defs/id"
        },
        "location": {
          "$ref": "#/$defs/scenarioEntry"
        },
        "participants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/participant"
          }
        },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/objective"
          }
        },
        "winConditions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "lossConditions": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/condition"
          },
          "default": []
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/outcome"
          }
        }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "actorArchetypeId",
        "count"
      ],
      "properties": {
        "role": {
          "enum": [
            "player",
            "ally",
            "hostile",
            "neutral",
            "hazard",
            "objective"
          ]
        },
        "actorArchetypeId": {
          "$ref": "#/$defs/id"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "type": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "maxLength": 160
        },
        "required": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objectiveIds": {
          "$ref": "#/$defs/localIdArray"
        },
        "timerExpired": {
          "$ref": "#/$defs/localId"
        },
        "allHostilesDefeated": {
          "type": "boolean"
        },
        "extractionReached": {
          "type": "boolean"
        }
      },
      "minProperties": 1
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "when"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "when": {
          "enum": [
            "win",
            "loss",
            "choice",
            "stage-complete"
          ]
        },
        "receiptIds": {
          "$ref": "#/$defs/idArray"
        },
        "consequenceTypeIds": {
          "$ref": "#/$defs/idArray"
        },
        "nextScenarioId": {
          "$ref": "#/$defs/id"
        }
      }
    }
  }
}
