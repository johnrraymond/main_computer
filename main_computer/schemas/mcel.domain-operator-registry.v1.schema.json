{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maincomputer.local/schemas/mcel.domain-operator-registry.v1.schema.json",
  "title": "MCEL Domain Operator Registry v1",
  "type": "object",
  "required": [
    "schema",
    "operators",
    "fingerprintAlgorithm",
    "fingerprint"
  ],
  "properties": {
    "schema": {
      "const": "mcel.domain-operator-registry.v1"
    },
    "operators": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operator"
      }
    },
    "fingerprintAlgorithm": {
      "const": "sha256-mcel-domain-operator-registry-v1"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "typeDescriptor": {
      "type": "object",
      "additionalProperties": true
    },
    "parameter": {
      "type": "object",
      "required": ["name", "schema"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "$ref": "#/$defs/typeDescriptor"
        }
      },
      "additionalProperties": false
    },
    "operator": {
      "type": "object",
      "required": [
        "schema",
        "id",
        "version",
        "parameters",
        "resultType",
        "allowedContexts",
        "purity",
        "determinism",
        "totality",
        "description"
      ],
      "properties": {
        "schema": {
          "const": "mcel.domain-operator.v1"
        },
        "id": {
          "type": "string",
          "pattern": "^operator:[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^v?[1-9][0-9]*(\\.[0-9]+){0,2}$"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "resultType": {
          "$ref": "#/$defs/typeDescriptor"
        },
        "allowedContexts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "purity": {
          "const": "pure"
        },
        "determinism": {
          "const": "deterministic"
        },
        "totality": {
          "enum": ["total", "partial-with-refusal"]
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
