"""Starter source contract smoke; add application-specific acceptance tests."""
from __future__ import annotations

import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def test_paired_source_manifest() -> None:
    manifest = json.loads((ROOT / "mcel.app.json").read_text(encoding="utf-8"))
    assert manifest["appId"] == {{APP_ID_JSON}}
    assert manifest["title"] == {{APP_TITLE_JSON}}
    assert manifest["authoring"] == {
        "format": "mcel.paired-html-js.v1",
        "html": "application.html",
        "script": "application.js",
    }
    assert (ROOT / manifest["authoring"]["html"]).is_file()
    assert (ROOT / manifest["authoring"]["script"]).is_file()
    assert manifest["conformance"]["currentMode"] == "paired-source-compiled"
    assert manifest["conformance"]["missingBridges"]
