          "type": "mc.boolean"
        },
        {
          "name": "is_main_computer",
          "source": "is_main_computer",
          "type": "mc.boolean",
          "evidence": "application-heuristic-not-os-authority"
        }
      ],
      "derivedProperties": [
        {
          "name": "role",
          "type": "mc.text",
          "evidence": "task-manager-application-classification; is_main_computer remains a heuristic, never OS authority",
          "rule": {
            "op": "first-true",
            "cases": [
              {
                "property": "is_current_process",
                "equals": true,
                "value": "current-process"
              },
              {
                "property": "is_main_computer",
                "equals": true,
                "value": "main-computer"
              }
            ],
            "default": "other-process"
          }
        }
      ]
    },
