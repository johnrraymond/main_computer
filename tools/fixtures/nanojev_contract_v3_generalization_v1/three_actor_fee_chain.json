{
  "language": "nanojev.contract.state_machine.v3",
  "asset": "native_eth",
  "settlement_mode": "pull",
  "payer": "deployer",
  "worker": "constructor_worker",
  "reviewer": "constructor_reviewer",
  "amount_wei": 2000,
  "deadline_seconds": 259200,
  "rules": [
    {
      "name": "submit",
      "actor": "worker",
      "from": "funded",
      "to": "submitted",
      "when": "before_deadline",
      "credits": [
        {
          "to": "reviewer",
          "amount_wei": 120
        }
      ]
    },
    {
      "name": "certify",
      "actor": "reviewer",
      "from": "submitted",
      "to": "certified",
      "when": "before_deadline",
      "credits": [
        {
          "to": "worker",
          "amount_wei": 800
        }
      ]
    },
    {
      "name": "close",
      "actor": "payer",
      "from": "certified",
      "to": "completed",
      "when": "before_deadline",
      "credits": [
        {
          "to": "worker",
          "amount_wei": "remaining"
        }
      ]
    },
    {
      "name": "refund_funded_payer",
      "actor": "payer",
      "from": "funded",
      "to": "refunded",
      "when": "at_or_after_deadline",
      "credits": [
        {
          "to": "payer",
          "amount_wei": "remaining"
        }
      ]
    },
    {
      "name": "refund_funded_worker",
      "actor": "worker",
      "from": "funded",
      "to": "refunded",
      "when": "at_or_after_deadline",
      "credits": [
        {
          "to": "payer",
          "amount_wei": "remaining"
        }
      ]
    },
    {
      "name": "refund_submitted_payer",
      "actor": "payer",
      "from": "submitted",
      "to": "refunded",
      "when": "at_or_after_deadline",
      "credits": [
        {
          "to": "payer",
          "amount_wei": "remaining"
        }
      ]
    },
    {
      "name": "refund_submitted_worker",
      "actor": "worker",
      "from": "submitted",
      "to": "refunded",
      "when": "at_or_after_deadline",
      "credits": [
        {
          "to": "payer",
          "amount_wei": "remaining"
        }
      ]
    },
    {
      "name": "refund_certified_payer",
      "actor": "payer",
      "from": "certified",
      "to": "refunded",
      "when": "at_or_after_deadline",
      "credits": [
        {
          "to": "payer",
          "amount_wei": "remaining"
        }
      ]
    },
    {
      "name": "refund_certified_worker",
      "actor": "worker",
      "from": "certified",
      "to": "refunded",
      "when": "at_or_after_deadline",
      "credits": [
        {
          "to": "payer",
          "amount_wei": "remaining"
        }
      ]
    }
  ]
}
