{
  "language": "nanojev.contract.state_machine.v3",
  "asset": "native_eth",
  "settlement_mode": "pull",
  "payer": "deployer",
  "worker": "constructor_worker",
  "reviewer": "constructor_reviewer",
  "amount_wei": 4099,
  "deadline_seconds": 777600,
  "rules": [
    {
      "name": "record_service",
      "actor": "reviewer",
      "from": "funded",
      "to": "holding",
      "when": "before_deadline",
      "credits": [
        {
          "to": "worker",
          "amount_wei": 1024
        }
      ]
    },
    {
      "name": "settle",
      "actor": "worker",
      "from": "holding",
      "to": "completed",
      "when": "before_deadline",
      "credits": [
        {
          "to": "reviewer",
          "amount_wei": "remaining"
        }
      ]
    },
    {
      "name": "refund_funded_payer",
      "actor": "payer",
      "from": "funded",
      "to": "refunded",
      "when": "at_or_after_deadline",
      "credits": [
        {
          "to": "payer",
          "amount_wei": "remaining"
        }
      ]
    },
    {
      "name": "refund_funded_worker",
      "actor": "worker",
      "from": "funded",
      "to": "refunded",
      "when": "at_or_after_deadline",
      "credits": [
        {
          "to": "payer",
          "amount_wei": "remaining"
        }
      ]
    },
    {
      "name": "refund_holding_payer",
      "actor": "payer",
      "from": "holding",
      "to": "refunded",
      "when": "at_or_after_deadline",
      "credits": [
        {
          "to": "payer",
          "amount_wei": "remaining"
        }
      ]
    },
    {
      "name": "refund_holding_worker",
      "actor": "worker",
      "from": "holding",
      "to": "refunded",
      "when": "at_or_after_deadline",
      "credits": [
        {
          "to": "payer",
          "amount_wei": "remaining"
        }
      ]
    }
  ]
}
