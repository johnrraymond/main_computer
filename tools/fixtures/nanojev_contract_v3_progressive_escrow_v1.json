{
  "language": "nanojev.contract.state_machine.v3",
  "asset": "native_eth",
  "settlement_mode": "pull",
  "payer": "deployer",
  "worker": "constructor_worker",
  "reviewer": "constructor_reviewer",
  "amount_wei": 12000000000000000000,
  "deadline_seconds": 1209600,
  "rules": [
    {
      "name": "approve_prototype",
      "actor": "payer",
      "from": "funded",
      "to": "prototype",
      "when": "before_deadline",
      "credits": [
        {
          "to": "worker",
          "amount_wei": 3000000000000000000
        }
      ]
    },
    {
      "name": "approve_beta",
      "actor": "payer",
      "from": "prototype",
      "to": "beta",
      "when": "before_deadline",
      "credits": [
        {
          "to": "worker",
          "amount_wei": 4000000000000000000
        }
      ]
    },
    {
      "name": "approve_final",
      "actor": "payer",
      "from": "beta",
      "to": "completed",
      "when": "before_deadline",
      "credits": [
        {
          "to": "worker",
          "amount_wei": 5000000000000000000
        }
      ]
    },
    {
      "name": "refund_funded_payer",
      "actor": "payer",
      "from": "funded",
      "to": "refunded",
      "when": "at_or_after_deadline",
      "credits": [
        {
          "to": "payer",
          "amount_wei": "remaining"
        }
      ]
    },
    {
      "name": "refund_funded_worker",
      "actor": "worker",
      "from": "funded",
      "to": "refunded",
      "when": "at_or_after_deadline",
      "credits": [
        {
          "to": "payer",
          "amount_wei": "remaining"
        }
      ]
    },
    {
      "name": "refund_prototype_payer",
      "actor": "payer",
      "from": "prototype",
      "to": "refunded",
      "when": "at_or_after_deadline",
      "credits": [
        {
          "to": "payer",
          "amount_wei": "remaining"
        }
      ]
    },
    {
      "name": "refund_prototype_worker",
      "actor": "worker",
      "from": "prototype",
      "to": "refunded",
      "when": "at_or_after_deadline",
      "credits": [
        {
          "to": "payer",
          "amount_wei": "remaining"
        }
      ]
    },
    {
      "name": "refund_beta_payer",
      "actor": "payer",
      "from": "beta",
      "to": "refunded",
      "when": "at_or_after_deadline",
      "credits": [
        {
          "to": "payer",
          "amount_wei": "remaining"
        }
      ]
    },
    {
      "name": "refund_beta_worker",
      "actor": "worker",
      "from": "beta",
      "to": "refunded",
      "when": "at_or_after_deadline",
      "credits": [
        {
          "to": "payer",
          "amount_wei": "remaining"
        }
      ]
    }
  ]
}
